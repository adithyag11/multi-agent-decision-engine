# Postgres connection used for BOTH the LangGraph checkpointer (durable
# execution state, replay/resume) and the audit ledger + run_queue
# (immutable regulator-facing trace + the durable work queue). Connects as
# the `engine_app` role (see db/roles.sql) -- can write the ledger but
# cannot UPDATE/DELETE it, and cannot read financial_statements/
# esg_disclosures at all.
DATABASE_URL=postgresql://engine_app:changeme@localhost:5432/decision_engine

# A SEPARATE connection, as the `engine_readonly` role (see db/roles.sql):
# SELECT-only on financial_statements/esg_disclosures, no grants anywhere
# else. This is a real, distinct role from DATABASE_URL's -- not the same
# credentials reused under a different name -- enforced by Postgres, not
# just by which Python function happens to call it. Only
# tools/data_warehouse.py (via app.db.pool.acquire_dw) ever connects here.
DATA_WAREHOUSE_URL=postgresql://engine_readonly:changeme@localhost:5432/decision_engine

# Anthropic API key for the LLM calls used ONLY for language understanding,
# routing selection, and narrative drafting -- never for arithmetic.
ANTHROPIC_API_KEY=sk-ant-...

# Model used by every agent node. Centralized so a model upgrade is a
# one-line config change, not a code change.
AGENT_MODEL=claude-sonnet-5

# Max number of Data Engineer <-> Risk/Critic conflict round-trips before
# the Supervisor gives up and escalates to a human reviewer.
MAX_CONFLICT_RETRIES=2

# API key registry, as a JSON object: key -> {name, scopes}. 'caller' can
# submit assessments and read status/trace; 'reviewer' can additionally
# resolve a human escalation via POST /resume. In a real deployment this is
# backed by an identity provider or a rotatable DB table, not a static env
# var -- this is the minimum viable version of "every request is
# attributable to a specific caller," not a full IAM system. Generate real
# keys with e.g. `openssl rand -hex 24`, prefixed however your ops team
# prefers (sk-caller-..., sk-reviewer-...) for readability in logs.
API_KEY_REGISTRY={"sk-caller-changeme":{"name":"credit-underwriting-svc","scopes":["caller"]},"sk-reviewer-changeme":{"name":"jane.reviewer@bank.example","scopes":["caller","reviewer"]}}

# How long a run_queue job may sit 'claimed' before a worker is presumed
# dead and another worker is allowed to reclaim and re-run it. Should
# comfortably exceed the slowest a single graph run is expected to take
# (several sequential LLM calls plus, in the worst case, several
# conflict-retry loops).
RUN_QUEUE_STALE_AFTER_SECONDS=300
